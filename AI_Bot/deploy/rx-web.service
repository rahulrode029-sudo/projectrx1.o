[Unit]
Description=RX web app (Flask behind nginx)
After=network.target

[Service]
Type=simple
User=rx
Group=rx
WorkingDirectory=/opt/rx/AI_Bot
EnvironmentFile=/opt/rx/AI_Bot/.env
# Waitress is a production WSGI server. It binds only to localhost;
# nginx handles public traffic and HTTPS.
ExecStart=/opt/rx/AI_Bot/venv/bin/waitress-serve --host=127.0.0.1 --port=5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
