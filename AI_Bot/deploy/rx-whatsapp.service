[Unit]
Description=RX WhatsApp sidecar (Baileys)
After=network.target rx-web.service
Wants=rx-web.service

[Service]
Type=simple
User=rx
Group=rx
WorkingDirectory=/opt/rx/AI_Bot/whatsapp_sidecar
EnvironmentFile=/opt/rx/AI_Bot/.env
# The sidecar posts events to FLASK_URL with X-WA-Secret, and keeps its
# login session in whatsapp_sidecar/auth on the VM's persistent disk.
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
