# Copy this file to .env and fill in the values.
# .env is gitignored, so your real keys are never committed.

# --- Google AI ---
# Get one at https://aistudio.google.com/apikey
Gemini_API_KEY=

# --- Telegram ---
# Get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat id, optional.
# The bot learns this the first time you send it /start.
TELEGRAM_OWNER_ID=

# --- Movies ---
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Which market to show streaming availability for.
# Two letter country code: IN, US, GB, AE and so on.
WATCH_REGION=IN

# --- WhatsApp sidecar ---
# Must match WA_SHARED_SECRET in the sidecar's environment.
# A random value is generated for you on first setup.
WA_SHARED_SECRET=

# Where the Flask app is listening.
WA_SIDECAR_URL=http://127.0.0.1:5000

# Your own WhatsApp number, optional. Not used by the code.
WA_OWNER_PHONE=

# The number to link the sidecar to, digits only with the country
# code. When this is set the sidecar asks for a pairing code
# automatically, so you can link without scanning the QR.
WA_PAIRING_PHONE=

# --- Models (defaults are fine) ---
# Flash models get overloaded (503) from time to time. If the chat model
# is unavailable the next one in this list is tried automatically.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Storage ---
DB_PATH=database/chatbote.db
MEDIA_DIR=database/media
