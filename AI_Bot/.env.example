# Copy this file to .env and fill in the values.
# .env is gitignored, so your real keys are never committed.

# --- Google AI ---
# Get one at https://aistudio.google.com/apikey
Gemini_API_KEY=

# --- Telegram (not used in the web-only deployment) ---
# Get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat id, optional.
# The bot learns this the first time you send it /start.
TELEGRAM_OWNER_ID=

# --- Web app login ---
# Accounts are created by the admin in /admin/users. Users sign in with
# a username AND a password. The first admin is bootstrapped below.
WEB_PASSWORD=

# First admin account. On first start an admin with these details is
# created automatically. ADMIN_PASSWORD defaults to WEB_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Used to send the forgot-password code to the admin's phone.
ADMIN_PHONE=919423031182

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# The Flask server binds here. Behind nginx on a VM, leave this as
# 127.0.0.1; nginx forwards public traffic to it.
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Debug mode must stay off in production.
WEB_DEBUG=false

# Timestamps are stored in UTC and shown in this zone on the website.
DISPLAY_TIMEZONE=Asia/Kolkata

# Set to 1 on the VM so run.py uses waitress instead of Flask's dev server.
RX_USE_WAITRESS=0

# --- Movies ---
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Which market to show streaming availability for.
# Two letter country code: IN, US, GB, AE and so on.
WATCH_REGION=IN

# --- WhatsApp sidecar ---
# Must match WA_SHARED_SECRET in the sidecar's environment.
# A random value is generated for you on first setup.
WA_SHARED_SECRET=

# Where the Flask app is listening.
WA_SIDECAR_URL=http://127.0.0.1:5000

# The URL the Node sidecar posts events to. On one VM this is the same
# local address as above. It must match the Flask app above.
FLASK_URL=http://127.0.0.1:5000

# Each account gets its own session folder under whatsapp_sidecar/auth/<id>
# and its own helper port (8787 + id). The launcher sets these for every
# sidecar automatically — do not set WA_AUTH_FOLDER or WA_HELPER_PORT here.

# Your own WhatsApp number, optional. Not used by the code.
WA_OWNER_PHONE=

# The admin's number, digits only with the country code. Only the admin
# sidecar uses this for an automatic pairing code. Every other user
# links their own WhatsApp by scanning the QR on /qr.
WA_PAIRING_PHONE=

# --- Forgot password ---
# Public URL used to build the reset link sent to a phone.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# OTP and reset links go through WhatsApp first. If that sidecar is
# offline, MSG91 SMS is used. Create templates at MSG91 with var1 as
# the code/link and var2 as the username, then get them approved.
MSG91_API_URL=https://control.msg91.com/api/v5/flow/
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RXINFO
MSG91_OTP_TEMPLATE_ID=
MSG91_RESET_TEMPLATE_ID=

# --- Models (defaults are fine) ---
# Flash models get overloaded (503) from time to time. If the chat model
# is unavailable the next one in this list is tried automatically.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Storage ---
DB_PATH=database/chatbote.db
MEDIA_DIR=database/media
