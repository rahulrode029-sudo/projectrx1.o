{
  "name": "whatsapp-sidecar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Connects to WhatsApp and forwards message and delete events to the Python app.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "setup": "patch-package",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "allowScripts": {
    "baileys@7.0.0-rc14": true,
    "protobufjs@7.6.6": true
  }
}
